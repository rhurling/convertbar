{
  "name": "convertbar",
  "private": true,
  "version": "2.6.0",
  "description": "Menu bar app for batch video conversion using HandBrakeCLI",
  "author": "Rouven Hurling",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rhurling/convertbar"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:web": "tsc && VITE_HEAD=server vite build --outDir dist-web --emptyOutDir",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
